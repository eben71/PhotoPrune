{
  "name": "photoprune",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "scripts": {
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "dependency:preflight": "node scripts/check-pnpm-release-age.mjs",
    "smoke:mvp": "playwright test --config=playwright.config.ts",
    "test:dependency-preflight": "node --test tests/dependency-preflight/*.test.mjs",
    "typecheck": "turbo typecheck",
    "test": "turbo test && node --test tests/deployment-boundary/*.test.mjs tests/agent-system/*.test.mjs",
    "test:agent-system": "node --test tests/agent-system/*.test.mjs",
    "test:deployment-boundary": "node --test tests/deployment-boundary/*.test.mjs",
    "check:deployment-boundary": "node scripts/check-deployment-boundary.mjs",
    "build": "turbo build",
    "check:docs": "node scripts/check-docs.js",
    "prepare": "node scripts/prepare-lefthook.cjs"
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "playwright": "^1.62.1",
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  }
}
